@echo off
chcp 65001 >nul
title Восстановление / Откат AionUi к эталону
color 0e

echo ======================================================================
echo           ОТКАТ AIONUI К ЭТАЛОННОМУ СОСТОЯНИЮ (GOLDEN IMAGE)
echo ======================================================================
echo.
echo ВНИМАНИЕ: Это действие вернет AionUi к стабильной эталонной версии:
echo  - Проверенная чистая база SQLite (целостность 100%%)
echo  - Все настроенные ассистенты (Claude Code, Gemini, Antigravity)
echo  - Перед откатом текущая база будет автоматически сохранена в бэкап.
echo.
set /p confirm="Вы уверены, что хотите выполнить откат? (y/n): "
if /i not "%confirm%"=="y" (
    echo Откат отменен пользователем.
    pause
    exit /b 0
)

echo.
echo Выполняется откат...
echo.

wsl -d Ubuntu -- python3 /mnt/d/My\ files/herdrControlGui/scripts/restore_aionui.py

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ======================================================================
    echo  [УСПЕХ] Откат к эталону выполнен успешно!
    echo  Перейдите в браузер на http://localhost:25808/#/guid и нажмите Ctrl+F5.
    echo ======================================================================
) else (
    echo.
    echo ======================================================================
    echo  [ОШИБКА] Произошла ошибка при откате. Проверьте вывод выше.
    echo ======================================================================
)

echo.
pause
